# ── Environment ──────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to Git!

# Origins allowed to call this API (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,https://ishwarambare.online,https://www.ishwarambare.online

# Secret key for JWT signing (generate with: openssl rand -hex 32)
SECRET_KEY=change-me-to-a-strong-secret-key

# "development" | "production"
ENVIRONMENT=development
